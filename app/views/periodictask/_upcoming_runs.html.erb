<%# Rule sentence (form only), one chip per run and a chevron link revealing the month grids. %>
<div class="periodictask-upcoming-runs">
<% if dates.any? %>
  <% if sentence %>
    <div class="periodictask-schedule-rule"><%= safe_join([periodictask_schedule_sentence(task, dates.first), periodictask_end_condition_note(task)].compact, ' ') %></div>
  <% end %>
  <div class="periodictask-run-chips">
    <% dates.each do |date| %><%= periodictask_run_chip(task, date) %> <% end %>
    <%= link_to periodictask_sprite_icon('angle-right', l(:label_calendar), rtl: true), '#',
                class: 'periodictask-calendar-toggle icon icon-collapsed', 'aria-expanded' => 'false' %>
  </div>
  <div class="periodictask-calendar" style="display: none;"><%= periodictask_run_calendar(task, dates) %></div>
<% elsif task.ended? %>
  <em class="periodictask-upcoming-runs-unavailable periodictask-upcoming-runs-ended"><%= l(:"label_#{task.end_reason}") %></em>
<% else %>
  <em class="periodictask-upcoming-runs-unavailable"><%= l(:label_next_occurrences_unavailable) %></em>
<% end %>
</div>
