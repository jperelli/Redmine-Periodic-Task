<%# Bulk actions on the checked rows of the list form +form+: a drop-down
    whose entries submit that form to their own URL, one "Export to ..." per
    CalendarExport format. Disabled until a row is checked. %>
<%= render 'periodictask/upcoming_runs_assets' %>
<div class="drdn periodictask-bulk-menu" data-form="<%= form %>">
  <span class="drdn-trigger icon icon-checked"><%= periodictask_sprite_icon('checked', l(:label_periodictask_bulk_actions)) %> &#9662;</span>
  <div class="drdn-content">
    <div class="drdn-items">
      <% RedminePeriodictask::CalendarExport.exporters.each do |exporter| %>
        <%= link_to periodictask_sprite_icon('download', l(:"label_periodictask_export_#{exporter::FORMAT}")),
                    "#{export_path}?export=#{exporter::FORMAT}",
                    class: "periodictask-bulk-action periodictask-export-#{exporter::FORMAT} icon icon-download disabled",
                    title: l(:text_periodictask_export_hint) %>
      <% end %>
    </div>
  </div>
</div>
