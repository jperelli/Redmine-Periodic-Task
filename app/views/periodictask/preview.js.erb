(function() {
  var box = $('#periodictask_upcoming_runs');
  var calendarShown = box.find('.periodictask-calendar').is(':visible');
  box.html('<%= escape_javascript(render :partial => 'upcoming_runs', :locals => { :task => @periodictask, :dates => @upcoming_run_dates, :sentence => true }) %>');
  if (calendarShown) { box.find('.periodictask-calendar-toggle').trigger('click'); }
})();
