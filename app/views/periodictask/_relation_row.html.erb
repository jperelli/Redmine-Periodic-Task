<% name = "periodictask[relations][#{index}]" %>
<% previous_issue = Periodictask.previous_issue_relation?(row) %>
<tr class="periodictask-relation-row">
  <td class="relation_type">
    <%= select_tag "#{name}[relation_type]",
                   options_for_select(periodictask_relation_type_options, row['relation_type']),
                   :style => 'width: auto' %>
  </td>
  <td class="issue_id">
    <%= select_tag "#{name}[target]",
                   options_for_select(periodictask_relation_target_options, previous_issue ? Periodictask::RELATION_PREVIOUS_ISSUE : 'issue'),
                   :style => 'width: auto', :class => 'periodictask-relation-target' %>
    <%= text_field_tag "#{name}[issue_id]", (previous_issue ? nil : row['issue_id']), :size => 10, :class => 'periodictask-relation-issue',
                       :style => ('display: none;' if previous_issue),
                       :data => { :autocomplete => auto_complete_issues_path(:project_id => @project, :scope => (Setting.cross_project_issue_relations? ? 'all' : nil)) } %>
  </td>
  <td class="delay">
    <span class="periodictask-relation-delay">
      <%= l(:field_delay) %>: <%= text_field_tag "#{name}[delay]", row['delay'], :size => 3 %> <%= l(:label_day_plural) %>
    </span>
  </td>
  <td class="buttons">
    <%= link_to periodictask_sprite_icon('del', l(:button_delete), icon_only: true), '#',
                :class => 'icon-only icon-del periodictask-remove-row', :title => l(:button_delete) %>
  </td>
</tr>
