api.issue do
  api.id @issue.id
  api.project(id: @issue.project_id, name: @issue.project.name)
  api.tracker(id: @issue.tracker_id, name: @issue.tracker.name)
  api.status(id: @issue.status_id, name: @issue.status.name)
  api.subject @issue.subject
  api.created_on @issue.created_on
  api.array(:errors) { @run_errors.each { |message| api.error message } }
end
