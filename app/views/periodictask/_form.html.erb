<%= error_messages_for 'periodictask', 'issue' %>

<%= f.hidden_field :id %>
<%= f.hidden_field :project_id %>

<fieldset class="box tabular">
  <legend><%= l(:label_periodictask_configuration) %></legend>
  <p>
    <%= label(:periodictask, :interval_number) do %><%= l(:label_interval) %> <span class="required">*</span><% end %>
    <%= f.number_field :interval_number, :required => true, :min => 1 %>
    <%= select 'periodictask', 'interval_units', Periodictask.interval_units_options %>
    <%= periodictask_recurrence_help_link %>
  </p>
  <%= render :partial => 'recurrence', :locals => { :periodictask => @periodictask } %>
  <p>
    <%= label(:periodictask, :next_run_date) do %><span class="field-description" title="<%= l(:label_next_run_date_info) %>"><%= l(:label_next_run_date) %></span><% end %>
    <%= f.datetime_field :next_run_date, :value => periodictask_next_run_date_input_value(@periodictask.next_run_date) %>
    <span class="periodictask-time-zone"><%= link_to periodictask_time_zone_label, my_account_path, :title => l(:label_my_account), :target => '_blank', :rel => 'noopener' %></span>
  </p>
  <p>
    <%= label(:periodictask, :author_id, l(:label_issue_author)) %>
    <% if @authors.length > 0 %>
      <%= f.select :author_id, principals_options_for_select(@authors, @periodictask.author) %>
    <% else %>
      <%= l(:no_members_in_project) %>
    <% end %>
  </p>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l(:label_periodictask_template) %></legend>
  <p>
    <label><%= l(:field_project) %></label>
    <%= @project %>
  </p>
  <p>
    <%= label(:periodictask, :tracker_id, l(:label_tracker)) %>
    <%= f.select :tracker_id, options_for_select(@project.trackers.map { |tracker| [tracker.name, tracker.id, { 'data-default-status-label' => periodictask_default_label(tracker.default_status&.name), 'data-done-ratio-enabled' => tracker.core_fields.include?('done_ratio') }] }, @periodictask.tracker_id) %>
  </p>
  <p>
    <%= label(:periodictask, :subject) do %><span class="field-description" title="<%= l(:subject_variables) %>"><%= l(:label_subject) %></span> <span class="required">*</span><% end %>
    <%= f.text_field :subject, :required => true, :style => 'width: 99%' %>
  </p>
  <p>
    <%= label(:periodictask, :description) do %><span class="field-description" title="<%= "#{l(:subject_variables)}\n\n#{l(:label_variables_markdown_note)}" %>"><%= l(:label_description) %></span><% end %>
    <%= f.text_area :description, :cols => 60, :rows => 10, :class => 'wiki-edit', :no_label => true %>
  </p>
  <%= wikitoolbar_for 'periodictask_description' %>

  <div class="attributes">
  <div class="splitcontent">
    <div class="splitcontentleft">
      <p>
        <%= label(:periodictask, :status_id, l(:field_status)) %>
        <%= f.select :status_id, IssueStatus.sorted.map { |s| [s.name, s.id] }, :include_blank => periodictask_default_label(@issue&.tracker&.default_status&.name) %>
      </p>
      <p>
        <%= label(:periodictask, :priority_id, l(:label_priority)) %>
        <%= f.select :priority_id, IssuePriority.active.map { |p| [p.name, p.id] }, :include_blank => periodictask_default_label(IssuePriority.default&.name) %>
      </p>
      <p>
        <%= label(:periodictask, :assigned_to_id) do %><%= l(:field_assigned_to) %> <span class="required">*</span><% end %>
        <% if @assignables.length > 0 %>
          <%= f.select :assigned_to_id, principals_options_for_select(@assignables, @periodictask.assigned_to), :include_blank => true, :required => true %>
          <% if @assignables.include?(User.current) %>
            <%= link_to l(:label_assign_to_me), '#', :class => 'assign-to-me-link', :style => 'padding-left: 5px;', :onclick => "$('#periodictask_assigned_to_id').val('#{User.current.id}').trigger('change'); return false;" %>
          <% end %>
        <% else %>
          <%= l(:no_members_in_project) %>
        <% end %>
      </p>
      <p>
        <%= label(:periodictask, :issue_category_id) do %><%= l(:field_category) %> <span class="required">*</span><% end %>
        <% if @categories.length > 0 %>
          <%= f.select :issue_category_id, principals_options_for_select(@categories, @periodictask.issue_category), :include_blank => true, :required => true %>
        <% else %>
          <%= l(:no_categories_in_project) %>
        <% end %>
      </p>
    </div>

    <div class="splitcontentright">
      <p>
        <%= label(:periodictask, :parent_id, l(:field_parent_issue)) %><%= f.text_field :parent_id, :size => 10 %>
      </p>
      <%= javascript_tag "observeAutocompleteField('periodictask_parent_id', '#{escape_javascript(auto_complete_issues_path(:project_id => @project, :scope => Setting.cross_project_subtasks, :status => 'o'))}')" %>
      <p>
        <%= label(:periodictask, :set_start_date) do %><span class="field-description" title="<%= l(:label_set_start_date_info) %>"><%= l(:label_set_start_date) %></span><% end %>
        <%= f.check_box :set_start_date %>
      </p>
      <p>
        <%= label(:periodictask, :due_date) do %><span class="field-description" title="<%= l(:label_due_date_info) %>"><%= l(:label_due_date) %></span><% end %>
        <%= f.text_field :due_date_number, :size => 3 %>
        <%= select 'periodictask', 'due_date_units', Periodictask.interval_units_options, {}, { :style => 'width: auto' } %>
      </p>
      <p>
        <%= label(:periodictask, :estimated_hours, l(:label_estimated_hours)) %>
        <%= f.text_field :estimated_hours, :size => 6, :value => format_hours(@periodictask.estimated_hours), :placeholder => 'h:mm' %> <%= l(:label_estimated_hours_after) %>
      </p>
      <% if Issue.use_field_for_done_ratio? %>
      <p id="periodictask_done_ratio_field" style="<%= 'display: none;' unless @periodictask.done_ratio_enabled? %>">
        <%= label(:periodictask, :done_ratio, l(:field_done_ratio)) %>
        <%= f.select :done_ratio, ((0..10).to_a.collect { |r| ["#{r * 10} %", r * 10] }), { :include_blank => periodictask_default_label('0 %') }, { :style => 'width: auto' } %>
      </p>
      <% end %>
    </div>
  </div>
  </div>

  <%= hidden_field_tag 'periodictask[watcher_user_ids][]', '' %>
  <p id="watchers_form"><label><%= l(:label_watchers) %></label>
    <span id="watchers_inputs">
      <%= watchers_checkboxes(@periodictask, users_for_new_periodictask_watchers(@periodictask)) %>
    </span>
    <% if User.current.allowed_to?(:add_issue_watchers, @project) %>
      <span class="search_for_watchers">
        <%= link_to periodictask_sprite_icon('add', l(:label_search_for_watchers), size: 12),
                    { :controller => 'watchers', :action => 'new', :project_id => @project },
                    :class => 'icon icon-add-bullet',
                    :remote => true, :method => 'get' %>
      </span>
    <% end %>
  </p>

  <% if checklist_plugin_installed? %>
    <p>
      <%= label(:periodictask, :checklists_template_id, l(:label_checklist_template)) %>
      <%= select :periodictask, :checklists_template_id, template_options_for_select(@project, f.object.checklists_template_id) %>
    </p>
  <% end %>
  <% if Periodictask.tags_plugin_installed? %>
    <p>
      <%= label(:periodictask, :tag_list) do %><span class="field-description" title="<%= l(:label_tags_info) %>"><%= l(:label_tags) %></span><% end %>
      <%= f.text_field :tag_list, :style => 'width: 99%', :autocomplete => 'off' %>
    </p>
  <% end %>
  <%= render :partial => 'subtasks_relations', :locals => { :periodictask => @periodictask } %>
  <% if @periodictask.last_error.present? %>
    <p>
      <%= label_tag(nil, l(:label_last_error)) %>
      <%= content_tag('span', @periodictask.last_error, :class => 'icon icon-error') %>
      <%= periodictask_recurrence_help_link(l(:label_last_error_help)) %>
    </p>
  <% end %>
</fieldset>

<div id="issue_custom_fields">
  <%= render :partial => 'customfields', :locals => { :issue => @issue } %>
</div>

<%= javascript_tag do %>
  $(document).ready(function() {
    function updateDefaultStatusLabel() {
      var label = $('#periodictask_tracker_id option:selected').attr('data-default-status-label');
      $('#periodictask_status_id option[value=""]').text(label);
    }

    function toggleDoneRatioField() {
      var enabled = $('#periodictask_tracker_id option:selected').attr('data-done-ratio-enabled') === 'true';
      $('#periodictask_done_ratio_field').toggle(enabled);
    }

    $('#periodictask_tracker_id').change(function() {
      updateDefaultStatusLabel();
      toggleDoneRatioField();
      $.ajax({
        url: '<%= escape_javascript(periodictask_customfields_path(@project, :format => 'js')) %>',
        type: 'post',
        data: $(this).closest('form').serialize()
      });
    });
    updateDefaultStatusLabel();

    // Show only the recurrence options that apply to the selected unit
    // (weekdays for weeks; monthly mode, and its occurrences/weekdays, for months).
    function toggleRecurrenceFields() {
      var units = $('#periodictask_interval_units').val();
      var monthlyMode = $('input[name="periodictask[monthly_mode]"]:checked').val();
      $('.periodictask-recurrence').each(function() {
        var $field = $(this);
        var visible = $.inArray(units, String($field.data('units')).split(' ')) !== -1;
        var mode = $field.data('monthly-mode');
        if (visible && units === 'month' && mode) { visible = mode === monthlyMode; }
        $field.toggle(visible);
      });
    }
    $('#periodictask_interval_units, input[name="periodictask[monthly_mode]"]').change(toggleRecurrenceFields);
    toggleRecurrenceFields();

    var currentUserId = '<%= User.current.id %>';
    function toggleAssignToMe() {
      $('.assign-to-me-link').toggle($('#periodictask_assigned_to_id').val() !== currentUserId);
    }
    $('#periodictask_assigned_to_id').change(toggleAssignToMe);
    toggleAssignToMe();

    // Comma-separated tags with autocomplete on the term being typed.
    var $tags = $('#periodictask_tag_list');
    if ($tags.length && $.fn.autocomplete) {
      function splitTags(val) { return val.split(/,\s*/); }
      function lastTerm(val) { return splitTags(val).pop(); }
      $tags.on('keydown', function(event) {
        if (event.keyCode === $.ui.keyCode.TAB && $(this).autocomplete('instance').menu.active) {
          event.preventDefault();
        }
      }).autocomplete({
        minLength: 1,
        source: function(request, response) {
          $.getJSON('<%= escape_javascript(periodictask_tags_path(@project)) %>', { term: lastTerm(request.term) }, response);
        },
        search: function() { return lastTerm(this.value).length >= 1; },
        focus: function() { return false; },
        select: function(event, ui) {
          var terms = splitTags(this.value);
          terms.pop();
          terms.push(ui.item.value);
          terms.push('');
          this.value = terms.join(', ');
          return false;
        }
      });
    }

    // Redmine's watcher picker (modal + append.js) emits inputs named
    // 'issue[watcher_user_ids][]'; rename them so they post into this form.
    $('#watchers_inputs').closest('form').on('submit', function() {
      $(this).find('input[name="issue[watcher_user_ids][]"]').attr('name', 'periodictask[watcher_user_ids][]');
    });

    <% if User.current.pref.warn_on_leaving_unsaved == '1' %>
    // Redmine's warnLeavingUnsaved only watches textareas; also guard the
    // rest of the form so navigating away mid-edit asks for confirmation.
    var form = $('#periodictask_next_run_date').closest('form');
    var unsaved = false;
    form.on('change', ':input', function() { unsaved = true; });
    form.on('submit', function() { unsaved = false; });
    $(window).on('beforeunload', function() {
      if (unsaved) { return '<%= escape_javascript l(:text_warn_on_leaving_unsaved) %>'; }
    });
    <% end %>
  });
<% end %>
